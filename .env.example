# Copie este arquivo pra ".env.local" (nao commitar) e preencha os valores.
# .env.local ja esta no .gitignore.

# --- Admin (login do painel /admin) -----------------------------------------
# Nao tem mais senha aqui: no primeiro acesso a /admin/login, a senha
# digitada e registrada (hash) em data/admin-credentials.json no
# servidor. Dali em diante so da pra entrar com essa senha - trocar so
# apagando esse arquivo na mao.
# String aleatoria longa, usada pra assinar o cookie de sessao. Gere uma com:
# openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Twitch (widget "Ao vivo") ---------------------------------------------
# Criar app em https://dev.twitch.tv/console/apps (Category: Website Integration)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Spotify (widget "Ouvindo agora", fonte principal — com progresso em tempo real) ---
# Client ID/Secret vem de https://developer.spotify.com/dashboard.
# SPOTIFY_REFRESH_TOKEN precisa ser gerado uma vez via Authorization Code
# Flow com os scopes user-read-currently-playing + user-read-playback-state.
# Sem esses 3 valores, o widget cai direto pro fallback do Last.fm abaixo.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- Last.fm (widget "Ouvindo agora", fallback/historico) --------------------
# Gerar em https://www.last.fm/api/account/create
LASTFM_API_KEY=

# --- Ranks (widget de Ranks) -------------------------------------------------
# Deadlock usa a deadlock-api.com e Overwatch usa a overfast-api.tekrop.fr —
# ambas sao publicas e gratuitas, sem chave de API. So precisa preencher
# steamAccountId / battleTag em src/content/site-content.ts (home.ranksWidget).

# --- Steam OpenID / Web API -------------------------------------------------
# Nunca exponha esta chave em NEXT_PUBLIC_* ou no navegador.
STEAM_WEB_API_KEY=
# Origem pública registrada na Steam, sem barra no final.
STEAM_OPENID_ORIGIN=https://nyxaim.space
# Se a API nao responder, o widget cai automaticamente pro fallback manual.

# --- CDN publica -------------------------------------------------------------
# Repositorio separado que hospeda imagens e outros arquivos estaticos.
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.jsdelivr.net/gh/6Horas/contentwebsite@main

# Optional: theme background video fallback. The default path is
# /public/video/shader-background-fallback.mp4 and can be changed in
# src/themes/nyx-base/theme.ts.
