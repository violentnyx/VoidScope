# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# persistent server state / credentials
/data/*.json

# local deployment credentials and server address
/deploy.config.local.json

# old nested project copy; the root app is the deployable project
/deadlock_project/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
